        {
          "id": "21d6b84c-4ab7-416a-8c02-1bbf973f5849",
          "name": "Looker Log Out",
          "request": {
            "name": "Looker Log Out",
            "description": {
              "content": "Revokes the current API access token, ending the authenticated session. After logout, the token can no longer be used.",
              "type": "text/plain"
            },
            "url": {
