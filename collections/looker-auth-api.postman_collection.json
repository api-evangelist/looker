                        "type": "text/plain"
                      },
                      "key": "client_secret",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"example_value\",\n  \"token_type\": \"example_value\",\n  \"expires_in\": 10,\n  \"refresh_token\": \"example_value\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
