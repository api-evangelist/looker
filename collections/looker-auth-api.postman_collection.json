      "name": "Auth",
      "description": {
        "content": "Authentication endpoints for obtaining and managing API access tokens using client credentials.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cd1c836c-d605-4686-866e-0041e94caf7a",
          "name": "Looker Log in",
          "request": {
            "name": "Looker Log in",
            "description": {
              "content": "Authenticates with the Looker API using client credentials and returns an access token. The client_id and client_secret are generated from the Looker Admin panel under Users > API Keys. The returned access token must be included as a Bearer token in the Authorization header for all subsequent API requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Looker instance hostname prefix",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) API client ID generated from Looker Admin"
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) API client secret generated from Looker Admin"
                }
              ]
            }
          },
          "response": [
            {
              "id": "ebfed5af-f8aa-4d28-b87a-0eb6c96f6d51",
              "name": "Successfully authenticated",
              "originalRequest": {
                "url": {
                  "path": [
                    "login"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Your Looker instance hostname prefix",
                      "type": "any",
                      "value": "{{instance}}",
                      "key": "instance"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
