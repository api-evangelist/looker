  "item": [
    {
      "id": "b86c42f1-f518-467a-942c-688efae2ab59",
      "name": "Query",
      "description": {
        "content": "Create and run queries against your Looker models. Queries define the fields, filters, sorts, and limits used to retrieve data from the underlying database through LookML models.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7c4c2b1f-be6a-4e67-9980-1994ca3622ed",
          "name": "Looker Create a Query",
          "request": {
            "name": "Looker Create a Query",
            "description": {
              "content": "Creates a new query object. A query defines the model, view, fields, filters, sorts, and limit used to retrieve data from the underlying database. The query is not executed until you call the run_query endpoint. Queries are immutable once created.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "queries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of field names to include in the response. Use this to limit response payload and improve performance."
                }
              ],
              "variable": [
                {
                  "description": "Your Looker instance hostname prefix",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
