{
  "info": {
    "_postman_id": "c18e31aa-1b65-4faf-986f-c10ce40519b3",
    "name": "Looker Auth API",
    "description": "The Looker API 4.0 provides programmatic access to the Looker business intelligence platform. It allows you to manage and interact with Looks, dashboards, queries, users, and other Looker resources. The API uses client credentials (client_id and client_secret) for authentication and returns JSON responses. Looker is part of Google Cloud and the API is available on any Looker instance at the /api/4.0 path.\n\nContact Support:\n Name: Google Cloud Looker Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:07:38.000Z",
    "updatedAt": "2026-07-28T02:07:39.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-c18e31aa-1b65-4faf-986f-c10ce40519b3"
  },
  "item": [
    {
      "name": "login",
      "item": [
        {
          "name": "Looker Log in",
          "id": "d5fb72a9-79ff-4cb7-af42-cb73b576b43a",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "description": "(Required) API client ID generated from Looker Admin",
                  "key": "client_id",
                  "value": "<string>"
                },
                {
                  "description": "(Required) API client secret generated from Looker Admin",
                  "key": "client_secret",
                  "value": "<string>"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Authenticates with the Looker API using client credentials and returns an access token. The client_id and client_secret are generated from the Looker Admin panel under Users > API Keys. The returned access token must be included as a Bearer token in the Authorization header for all subsequent API requests."
          },
          "response": [
            {
              "id": "ef404e3b-b781-471a-9ade-d129faa6a753",
              "name": "Successfully authenticated",
              "originalRequest": {
